# WordPress core, uploads and ephemeral runtime directories
/app/public/wp-config.php
/app/public/wp-content/uploads/
/app/public/wp-content/upgrade/
/app/public/wp-content/cache/
/app/public/wp-content/blogs.dir/
/app/public/backups/

# Local server config and logs
/conf/
/logs/
*.log
**/*.log
*.log.*
app/public/wp-content/debug.log
ajax_log*.txt
head_debug.html
*debug_dump*
*-debug*.html

# OS and filesystem artifacts
.DS_Store
**/.DS_Store
Thumbs.db
**/*.bak
**/*~

# Environment, secrets, and credentials
.env
.env*
*.env
*.env.*
**/.env
**/.env*
.env.local
.env.production
.env.development
.envrc
*.pem
*.key
*.secret
*credentials*
*secret*

# IDE & Editor artifacts
.vscode/
.idea/
*.swp
*.swo

# Node & package dependencies
node_modules/
**/node_modules/
.npm/

# Scratch & temporary development scripts
scratch/
**/scratch/
scratch_*
**/scratch_*

# Duplicate / OS Copy artifacts
* (1)*
* (2)*
* (3)*
* (4)*

# Production releases and archives (whitelist updates/ releases)
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
!updates/*.zip

