# ====================================================================
# CORA STUDIO OS - OMNICHANNEL TRACKING & ANALYTICS ENVIRONMENT KEYS
# ====================================================================

# 1. Google Analytics 4 (Format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# 2. Google Tag Manager (Format: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# 3. Google Search Console Verification Token
NEXT_PUBLIC_GSC_VERIFICATION=cora-google-search-console-verification

# 4. Meta Pixel / Facebook Ads (Format: 15-16 digit numeric ID e.g. 123456789012345)
NEXT_PUBLIC_META_PIXEL_ID=

# 5. Microsoft Clarity (Format: 10-12 character alphanumeric string e.g. abc123def4)
NEXT_PUBLIC_CLARITY_ID=

# 6. LinkedIn Insight Tag (Format: 6-8 digit numeric ID e.g. 1234567)
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# 7. Razorpay Key ID (For live client checkout & upgrades)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXX
